RPC_URL=https://api.devnet.solana.com
NETWORK=devnet

# For testing - no pre-funded wallet needed on devnet
# PRE_FUNDED_WALLET_PRIVATE_KEY=
MAX_REQUESTS_PER_MINUTE=10
MAX_TOKENS_PER_USER=5

# Smart Sell Settings
SMART_SELL_ENABLED=false
SMART_SELL_PERCENTAGE=50.0
SMART_SELL_STOP_HOLD_PERCENTAGE=5.0
SMART_SELL_MIN_SOL_TRIGGER=0.5

# Advanced Smart Sell Features
ANTIBUBBLE_DETECTION=false
BYPASS_JITO=false
BUBBLE_MAP_API_KEY=
JITO_FEE_MULTIPLIER=1.5