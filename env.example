
# Solana RPC Configuration  
# For mainnet: https://api.mainnet-beta.solana.com
# For devnet: https://api.devnet.solana.com
# Shyft RPC (Paid Plan): https://rpc.shyft.to?api_key=6AC3vTBB5lObDYTm
RPC_URL=https://rpc.shyft.to?api_key=6AC3vTBB5lObDYTm

# Backup RPC endpoints for failover (optional)
RPC_URL_2=https://api.mainnet-beta.solana.com
RPC_URL_3=https://solana-api.projectserum.com

# Dedicated RPCs (configure these in Settings page for optimal performance)
# For live trade monitoring (Activity Feed) - WebSocket format
# Recommended: Helius RPC (free tier available) - https://helius.dev
MONITORING_RPC_WSS=wss://mainnet.helius-rpc.com/?api-key=67c1bc22-c773-4b3d-8e26-ee21d6aa3518

# For market cap/price updates - HTTP format  
# Recommended: Helius RPC for market cap monitoring (different from activity feed RPC)
PRICE_RPC_HTTP=https://mainnet.helius-rpc.com/?api-key=7a9f49da-3f5d-4fdd-afc0-79695ad80ebf

# Helius Enhanced API (optional - auto-extracted from RPC URLs if not provided)
# Used for faster transaction parsing in activity feed
# Should match the API key from MONITORING_RPC_WSS since it's used for activity feed
HELIUS_API_KEY=67c1bc22-c773-4b3d-8e26-ee21d6aa3518

# Birdeye API (optional - for token metadata fallback)
# Improves reliability when fetching token name, symbol, and image
# Get your API key from https://birdeye.so
BIRDEYE_API_KEY=9ddbf4282f714067a229ad9caedd1b41

# Moralis Pump.fun API (optional - for Pump.fun specific data)
# Provides specialized endpoints for Pump.fun tokens (price, metadata, trades)
# Get your API key from https://developers.moralis.com
# Free tier: 25 requests/second
MORALIS_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJub25jZSI6IjY3MWQyMmQ5LTllZTQtNDJmNi1iMzE1LTRkN2M5MTQxMjE1MSIsIm9yZ0lkIjoiNDgxNDM3IiwidXNlcklkIjoiNDk1MzA0IiwidHlwZUlkIjoiODdkMjNkYjctZTBkMC00NjY4LTkzYzYtMTUzYzRkMjQxZWEzIiwidHlwZSI6IlBST0pFQ1QiLCJpYXQiOjE3NjMxNjU5NDEsImV4cCI6NDkxODkyNTk0MX0.9ZJGROi8myhSMDhZi1icj5YBava7ecojyZG6Ruf5PU4

# Network Configuration
# Use 'mainnet-beta' for production (requires funded wallet)
# Use 'devnet' for testing with auto-funding
NETWORK=mainnet-beta

# Trading Configuration
# Slippage tolerance for trades (in basis points, 100 = 1%)
DEFAULT_SLIPPAGE=300
# Priority fee for transactions (in lamports)
PRIORITY_FEE=5000
# Maximum retries for failed transactions
MAX_RETRIES=3

# IPFS / Media Upload (Pinata recommended)
# Provide a Pinata JWT (https://docs.pinata.cloud/docs/jwt)
PINATA_JWT=
# Optional custom gateway URL (defaults to https://gateway.pinata.cloud/ipfs)
PINATA_GATEWAY_URL=

# Pre-funded Wallet Configuration
# For devnet: Leave empty for auto-generated wallet
# For mainnet: Add your funded wallet's private key (base58 encoded)
PRE_FUNDED_WALLET_PRIVATE_KEY=
MIN_WALLET_BALANCE=50000000
REFILL_THRESHOLD=10000000
REFILL_AMOUNT=1000000000

# Logging Configuration
LOG_LEVEL=info
ENABLE_DEBUG=false

# Jupiter Tagging IPs
JUPITER_STATIC_IPS=104.26.10.85,104.26.11.85,172.67.74.52

# PumpPortal API Configuration
PUMPPORTAL_API_KEY=
PUMPPORTAL_SLIPPAGE=10
PUMPPORTAL_PRIORITY_FEE=0.0005
PUMPPORTAL_POOL=pump
PUMPPORTAL_MAYHEM_MODE=false

# Web Server Configuration
WEB_PORT=3000
CHAOSBOT_STORAGE_SECRET=