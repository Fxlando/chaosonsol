# Solana RPC Configuration  
# Premium Ankr RPC (1,500 RPS) - Production Ready
RPC_URL=https://rpc.ankr.com/solana/0420a9599f84c238839150272c7dc114e8d6fa8722dfd48b5c92e0a81be23d27

# Network Configuration
NETWORK=mainnet-beta

# Trading Configuration
DEFAULT_SLIPPAGE=100
PRIORITY_FEE=1000
MAX_RETRIES=3

# Wallet Configuration
MIN_WALLET_BALANCE=50000000
REFILL_THRESHOLD=10000000
REFILL_AMOUNT=1000000000

# Web Server Configuration
WEB_PORT=3000
NODE_ENV=production

# Logging Configuration
LOG_LEVEL=info
ENABLE_DEBUG=false

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ENCRYPTION_KEY=your-encryption-key-32-chars-long

# Trading Limits
MAX_TRADES_PER_MINUTE=50
MAX_WALLETS_PER_OPERATION=100
MAX_SOL_PER_TRADE=10

# RPC Pool Configuration
RPC_POOL_SIZE=4
RPC_TIMEOUT=30000
RPC_RETRY_ATTEMPTS=3

# Cache Configuration
CACHE_TTL=300000
ENABLE_CACHE=true

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090
