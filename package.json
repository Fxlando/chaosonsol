{
  "name": "chaos-bot-solana-platform",
  "version": "2.0.0",
  "description": "Production-ready Solana trading platform with PumpFun, Raydium DEX, and optimized RPC",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node simple-bot.js",
    "start:production": "node start-production-system.js",
    "dev": "node --watch simple-bot.js",
    "web": "node webapp/api-server.js",
    "web:production": "node webapp/production-api-server.js",
    "api": "node server.js",
    "api:dev": "node --watch server.js",
    "build": "node scripts/build.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": [
    "solana",
    "telegram",
    "bot",
    "wallet",
    "manager",
    "crypto"
  ],
  "author": "Simple Wallet Manager",
  "license": "MIT",
  "dependencies": {
    "@solana/spl-token": "^0.4.8",
    "@solana/web3.js": "^1.95.2",
    "axios": "^1.6.8",
    "bs58": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "pumpfun-sdk": "^1.0.3",
    "socket.io": "^4.8.1",
    "telegraf": "^4.16.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Fxlando/chaosonsol.git"
  },
  "bugs": {
    "url": "https://github.com/Fxlando/chaosonsol/issues"
  },
  "homepage": "https://github.com/Fxlando/chaosonsol#readme"
}
